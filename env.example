# Application Configuration
# Both new (APP_*) and legacy (yon.*) formats are supported
# Copy this file to .env and update values

# Environment: development, production
APP_ENV=development
# yon.server.env=development

# Server
PORT=8080
APP_NAME=academic-api
CONTEXT_PATH=/
# yon.server.port=8080
# yon.server.appName=academic-api
# yon.server.context.path=/

# Timezone
TZ=Asia/Jakarta
# yon.server.timezone=Asia/Jakarta

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_academic
DB_USER=postgres
DB_PASSWORD=your_password
# yon.database.type=postgres
# yon.database.host=localhost
# yon.database.port=5432
# yon.database.db=db_academic
# yon.database.user=postgres
# yon.database.password=your_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-secret-key
JWT_EXPIRY=24h
# yon.security.secret_key=your-secret-key

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=academic
MINIO_USE_SSL=false

